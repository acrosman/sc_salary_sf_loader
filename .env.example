# ============================================================
# sc_salary_sf_loader — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your values.
# The .env file is listed in .gitignore and must NEVER be
# committed to source control.
# ============================================================

# ------------------------------------------------------------
# Salesforce — OAuth2 JWT Bearer Token Flow
# ------------------------------------------------------------
# Consumer Key from your Connected App in Salesforce Setup.
SALESFORCE_CONSUMER_KEY=your_connected_app_consumer_key_here

# Absolute or relative path to the RSA private key PEM file
# used to sign the JWT assertion.
# Generate with:
#   openssl genrsa -out sf_private_key.pem 2048
#   openssl rsa -in sf_private_key.pem -pubout -out sf_public_key.pem
# Upload sf_public_key.pem to the Connected App in Salesforce.
SALESFORCE_PRIVATE_KEY_PATH=./sf_private_key.pem

# Salesforce username that has been pre-authorised for the Connected App.
SALESFORCE_USERNAME=user@example.com

# 'login' for production / Developer Edition orgs.
# 'test' for sandboxes.
SALESFORCE_DOMAIN=login

# ------------------------------------------------------------
# Google BigQuery
# ------------------------------------------------------------
# Google Cloud project that owns the BigQuery dataset.
BQ_PROJECT_ID=your-gcp-project-id

# BigQuery dataset that contains the Person and Salary tables.
BQ_DATASET_ID=sc_salary_data

# Path to the service account JSON key file.
# Alternatively, set the standard GOOGLE_APPLICATION_CREDENTIALS env var.
BQ_CREDENTIALS_FILE=./bq_service_account.json
